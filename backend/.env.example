## ThreatSim backend (FastAPI) environment
## Copy to `backend/.env` and fill values as needed.

# --- Phase 2: AI ingestion (optional) ---
# Get from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default: gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash

# NVD API key (optional but recommended for rate limits):
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# --- Phase 3: Supabase (optional) ---
# Server-side ONLY. Never expose these to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT secret (Settings → API → JWT Secret)
# Required to verify browser access tokens for authenticated sessions and lobbies.
SUPABASE_JWT_SECRET=

